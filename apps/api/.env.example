# Copy to .env and adjust.
DATABASE_URL="postgresql://iwear:iwear@localhost:5432/iwear?schema=public"
PORT=3001
# Comma-separated list of origins allowed to call the API (the Nuxt site).
CORS_ORIGINS="http://localhost:3000"
# Use a long random string in production.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
# The first admin account, created by `npm run db:seed`.
ADMIN_EMAIL="admin@iwear.local"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Iwear Admin"

# Where uploaded photos are saved (served at /uploads).
UPLOAD_DIR="uploads"
