// Iwear data model. Phase 1: accounts, roles and companies.
// Later phases add products, try-on sessions, orders and deliveries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMPANY
  CUSTOMER
  COURIER
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A COMPANY user owns exactly one company.
  company           Company?  @relation("CompanyOwner")
  reviewedCompanies Company[] @relation("CompanyReviewer")

  @@index([role])
}

model Company {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  description     String?
  phone           String?
  website         String?
  address         String?
  logoUrl         String?
  status          CompanyStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  ownerId String @unique
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("CompanyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  products Product[]

  @@index([status])
}

enum Category {
  DRESS
  TOP
  BOTTOM
  OUTERWEAR
  SUIT
  ACCESSORY
}

/// A piece of clothing a company sells. Only published products of approved companies are public.
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    Category
  /// Price in Uzbek so'm (whole numbers).
  price       Int
  colors      String[]
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sizes  ProductSize[]
  images ProductImage[]

  @@index([companyId, isPublished])
  @@index([category])
}

/// One size of a product with its stock and, optionally, body measurements it fits.
/// The measurements feed the AI size suggestion later.
model ProductSize {
  id        String @id @default(uuid())
  label     String
  stock     Int    @default(0)
  chestCm   Int?
  waistCm   Int?
  hipsCm    Int?
  sortOrder Int    @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
}

model ProductImage {
  id        String @id @default(uuid())
  url       String
  sortOrder Int    @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
